{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "routes": [
    {
      "src": "^/(?:(.+)/)?index(?:\\.html)?/?$",
      "headers": { "Location": "/$1" },
      "status": 308
    },
    {
      "src": "^/(?!google309bb75b72291029\\.html$)(.*)\\.html/?$",
      "headers": { "Location": "/$1" },
      "status": 308
    },
    {
      "src": "^/api/(.*)\\.js/?$",
      "headers": { "Location": "/api/$1" },
      "status": 308
    },
    {
      "src": "^/(.*)/$",
      "headers": { "Location": "/$1" },
      "status": 308
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!api(?:/|$)).+)",
      "destination": "/:path.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
